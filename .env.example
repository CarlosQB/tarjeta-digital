# Copia este archivo como .env.local y pon los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). No subas .env.local a GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la app (en Vercel, tu dominio). Se usa para el QR y los correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
